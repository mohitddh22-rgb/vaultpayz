# ─────────────────────────────────────────────────────────────
# VaultPayz web app — environment
#
# MODE: "mock" runs fully in-memory with seeded demo data (no external services).
#       Set MODE=supabase (and fill Supabase vars) for real persistence.
#
# ALL external APIs (SafeGold, Razorpay, SendGrid) default to MOCK below,
# so you can run the app with zero credentials and realistic demo data.
# ─────────────────────────────────────────────────────────────
VAULTPAYZ_MODE=mock

# Supabase (only needed when MODE=supabase) — leave EMPTY for mock
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SafeGold — REAL stage token from onboarding email is pre-filled, but MOCK=true
# means no live calls are made. Set SAFEGOLD_MOCK=false + SAFEGOLD_BASE_URL to go live.
SAFEGOLD_BASE_URL=
SAFEGOLD_TOKEN=4cd398d7bbe13748c0ef3c756f1cdba2
SAFEGOLD_HMAC_SECRET=
SAFEGOLD_PARTNER_USER_ID=
SAFEGOLD_MOCK=true

# Razorpay — fully mocked (no real charges). Fill test keys + set RAZORPAY_MOCK=false to go live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MOCK=true

# SendGrid — mocked (no emails sent). Fill API key to go live.
SENDGRID_API_KEY=

# Fee config (mirrors system_config)
P2P_FEE_RATE=0.0033
SPREAD_RATE=0.015

# Seed demo data on first load (mock mode). Set to false to start empty.
SEED_DEMO_DATA=true
