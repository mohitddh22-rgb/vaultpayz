# ─────────────────────────────────────────────────────────────
# VaultPayz web app — environment
#
# MODE: "mock" runs fully in-memory (no external services needed).
#       Set MODE=supabase (and fill the vars below) for real persistence.
# ─────────────────────────────────────────────────────────────
VAULTPAYZ_MODE=mock

# Supabase (only needed when MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SafeGold — real stage/live API. Leave SAFEGOLD_BASE_URL empty to use mock.
# Stage token from onboarding email: 4cd398d7bbe13748c0ef3c756f1cdba2
SAFEGOLD_BASE_URL=
SAFEGOLD_TOKEN=4cd398d7bbe13748c0ef3c756f1cdba2
SAFEGOLD_HMAC_SECRET=
SAFEGOLD_MOCK=true

# Razorpay — mock by default (no real charges in demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=demo-webhook-secret
RAZORPAY_MOCK=true

# Fee config (mirrors system_config)
P2P_FEE_RATE=0.0033
SPREAD_RATE=0.015
